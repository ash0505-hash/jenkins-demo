
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Downloading code from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Application Build Started'
            }
        }

        stage('Test') {
            steps {
                echo 'Application Testing Started'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Application Deployment Started'
            }
        }
    }
}
